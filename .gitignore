# ----------------------------------------------------------
# KEEP IMPORTANT PROJECT FILES TRACKED
# ----------------------------------------------------------

!README.md
!AGENTS.md

!docs/
!docs/**

!**/package.json
!**/pnpm-lock.yaml
!**/pubspec.yaml
!**/pubspec.lock
!**/.gitignore

# Configuración local de autenticación (sin credenciales en Git)
/mobile/config/firebase.android.json
/backend/secrets/

# Caché de herramientas Python locales
__pycache__/
*.pyc

# Cliente Prisma regenerado a partir del esquema versionado
/backend/src/generated/prisma/
