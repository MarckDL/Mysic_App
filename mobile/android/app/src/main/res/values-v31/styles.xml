<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/mysic_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/mysic_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/mysic_paper</item>
        <item name="android:navigationBarColor">@color/mysic_ink</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/mysic_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/mysic_paper</item>
    </style>
</resources>
