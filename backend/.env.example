NODE_ENV=development
PORT=3000

# Debe coincidir con el proyecto registrado en Android.
FIREBASE_PROJECT_ID=
# Ruta absoluta a un JSON administrativo guardado FUERA del repositorio.
# También se admiten Application Default Credentials del entorno de despliegue.
GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL: runtime y migraciones; solo valores locales, nunca publicar credenciales.
DATABASE_URL=
DIRECT_URL=
# Opcional: certificado CA descargado de Supabase, fuera del repositorio.
DATABASE_SSL_CA_FILE=
