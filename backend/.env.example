NODE_ENV=development
PORT=3000

# Debe coincidir con el proyecto registrado en Android.
FIREBASE_PROJECT_ID=
# Ruta absoluta a un JSON administrativo guardado FUERA del repositorio.
# También se admiten Application Default Credentials del entorno de despliegue.
GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL: runtime y migraciones; solo valores locales, nunca publicar credenciales.
DATABASE_URL=
DIRECT_URL=
# Opcional: certificado CA descargado de Supabase, fuera del repositorio.
DATABASE_SSL_CA_FILE=

# Biblioteca oficial de YouTube. Los valores de operación se inyectan en el backend.
YOUTUBE_LINK_ENABLED=false
# YOUTUBE_OAUTH_CLIENT_ID=
# YOUTUBE_OAUTH_CLIENT_SECRET=
# YOUTUBE_OAUTH_CALLBACK=https://api.example.test/api/v1/integrations/youtube/oauth/callback
# YOUTUBE_APP_RETURN=https://app.example.test/library/youtube/return
# YOUTUBE_TOKEN_KEY_ID=v1
# YOUTUBE_TOKEN_KEYS={"v1":"<32 bytes aleatorios en base64>"}
# Certificados públicos del APK piloto en formato SHA-256 separado por dos puntos.
YOUTUBE_ANDROID_SHA256=
