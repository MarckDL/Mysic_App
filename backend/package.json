{
  "name": "@mysic/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:validate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js validate",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate status",
    "db:check": "tsx --env-file-if-exists=.env tool/check-database.ts",
    "catalog:check": "node --import tsx tool/check-catalog.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "youtubei.js": "18.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.0.0",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
