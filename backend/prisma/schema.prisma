generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mysic"]
}

model User {
  id                     String                     @id @default(uuid()) @db.Uuid
  firebaseUid            String                     @unique @map("firebase_uid") @db.VarChar(128)
  googleId               String?                    @unique @map("google_id") @db.VarChar(255)
  email                  String?                    @db.VarChar(320)
  displayName            String                     @map("display_name") @db.VarChar(150)
  nickname               String?                    @db.VarChar(24)
  photoUrl               String?                    @map("photo_url") @db.Text
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  youtubeConnection      ExternalMusicConnection?
  youtubeAttempts        ExternalMusicLinkAttempt[]
  imports                MusicImport[]
  history                ListeningHistory[]
  playlists              Playlist[]
  favorites              Favorite[]
  ratings                Rating[]
  comments               Comment[]
  commentReports         CommentReport[]            @relation("Reporter")
  resolvedCommentReports CommentReport[]            @relation("Moderator")

  @@map("users")
  @@schema("mysic")
}

enum PlaylistVisibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")

  @@map("playlist_visibility")
  @@schema("mysic")
}

model Track {
  id                String             @id @default(uuid()) @db.Uuid
  source            String             @db.VarChar(50)
  sourceId          String             @map("source_id") @db.VarChar(255)
  title             String             @db.VarChar(500)
  artistName        String             @map("artist_name") @db.VarChar(255)
  durationSeconds   Int?               @map("duration_seconds")
  thumbnailUrl      String?            @map("thumbnail_url") @db.Text
  metadataUpdatedAt DateTime           @default(now()) @map("metadata_updated_at") @db.Timestamptz(6)
  history           ListeningHistory[]
  playlistTracks    PlaylistTrack[]
  favorites         Favorite[]
  ratings           Rating[]
  comments          Comment[]

  @@unique([source, sourceId])
  @@map("tracks")
  @@schema("mysic")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([userId, trackId])
  @@index([userId, createdAt])
  @@index([trackId])
  @@map("favorites")
  @@schema("mysic")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("ratings")
  @@schema("mysic")
}

model MusicImport {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  fingerprint  String    @db.VarChar(64)
  name         String    @db.VarChar(150)
  items        Json
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  playlistId   String?   @map("playlist_id") @db.Uuid
  savedCount   Int       @default(0) @map("saved_count")
  skippedCount Int       @default(0) @map("skipped_count")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlist     Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([confirmedAt, expiresAt])
  @@index([playlistId])
  @@map("music_imports")
  @@schema("mysic")
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  name        String             @db.VarChar(150)
  description String?            @db.Text
  visibility  PlaylistVisibility @default(PRIVATE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  imports     MusicImport[]
  tracks      PlaylistTrack[]

  @@index([userId, updatedAt])
  @@map("playlists")
  @@schema("mysic")
}

model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
  @@schema("mysic")
}

enum CommentStatus {
  visible
  hidden
  deleted

  @@map("comment_status")
  @@schema("mysic")
}

enum CommentReportReason {
  spam
  harassment
  other

  @@map("comment_report_reason")
  @@schema("mysic")
}

enum CommentReportStatus {
  pending
  dismissed
  hidden
  deleted

  @@map("comment_report_status")
  @@schema("mysic")
}

model Comment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  trackId   String          @map("track_id") @db.Uuid
  body      String
  status    CommentStatus   @default(visible)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  reports   CommentReport[]

  @@index([trackId, status, createdAt, id])
  @@index([userId])
  @@map("comments")
  @@schema("mysic")
}

model CommentReport {
  commentId   String              @map("comment_id") @db.Uuid
  reporterId  String              @map("reporter_id") @db.Uuid
  reason      CommentReportReason
  status      CommentReportStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  moderatorId String?             @map("moderator_id") @db.Uuid
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(3)
  comment     Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter    User                @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User?               @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@id([commentId, reporterId])
  @@index([status, commentId, createdAt])
  @@index([reporterId])
  @@index([moderatorId])
  @@map("comment_reports")
  @@schema("mysic")
}

model ListeningHistory {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  playbackSessionId String   @unique @map("playback_session_id") @db.Uuid
  startedAt         DateTime @map("started_at") @db.Timestamptz(3)
  listenedMs        BigInt   @map("listened_ms")
  completed         Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt, id])
  @@index([userId, trackId])
  @@map("listening_history")
  @@schema("mysic")
}

model ExternalMusicLinkAttempt {
  id           String   @id @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestKey   String   @db.Uuid
  status       String
  reason       String?
  expiresAt    DateTime @db.Timestamptz(3)
  launchHash   String?  @unique
  launchBox    String?
  stateHash    String?  @unique
  cookieHash   String?
  nonceHash    String?
  verifierBox  String?
  returnHash   String?
  forceConsent Boolean  @default(false)
  subject      String?
  channelId    String?
  channelTitle String?
  refreshBox   String?
  scopes       String?

  @@unique([userId, requestKey])
  @@index([expiresAt])
  @@index([subject])
  @@map("external_music_link_attempts")
  @@schema("mysic")
}

model ExternalMusicConnection {
  appListens         ChannelMusicListen[]
  mysicHistoryPaused Boolean              @default(false)
  mysicActivityEpoch Int                  @default(0)
  mysicLibraryId     String?              @db.Uuid
  userId             String               @id @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            String               @unique
  channelId          String
  channelTitle       String
  status             String
  generation         String               @unique @db.Uuid
  refreshBox         String?
  scopes             String
  connectedAt        DateTime             @default(now()) @db.Timestamptz(3)
  checkedAt          DateTime             @default(now()) @db.Timestamptz(3)
  lease              String?              @db.Uuid
  leaseUntil         DateTime?            @db.Timestamptz(3)

  @@index([status, checkedAt])
  @@map("external_music_connections")
  @@schema("mysic")
}

model ChannelMusicListen {
  userId     String                  @db.Uuid
  generation String                  @db.Uuid
  listenId   String                  @db.Uuid
  videoId    String                  @db.VarChar(11)
  listenedMs Int
  playedAt   DateTime                @default(now()) @db.Timestamptz(3)
  connection ExternalMusicConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, generation, listenId])
  @@index([userId, generation, playedAt, listenId])
  @@map("channel_music_listens")
  @@schema("mysic")
}

model ExternalMusicRevocationJob {
  id         String   @id @db.Uuid
  subject    String   @unique
  ownerId    String   @db.Uuid
  refreshBox String
  tries      Int      @default(0)
  nextAt     DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([nextAt])
  @@index([ownerId])
  @@map("external_music_revocations")
  @@schema("mysic")
}
