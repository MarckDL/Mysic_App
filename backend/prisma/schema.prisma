generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mysic"]
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  firebaseUid            String             @unique @map("firebase_uid") @db.VarChar(128)
  googleId               String?            @unique @map("google_id") @db.VarChar(255)
  email                  String?            @db.VarChar(320)
  displayName            String             @map("display_name") @db.VarChar(150)
  nickname               String?            @db.VarChar(24)
  photoUrl               String?            @map("photo_url") @db.Text
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  history                ListeningHistory[]
  playlists              Playlist[]
  favorites              Favorite[]
  ratings                Rating[]
  comments               Comment[]
  commentReports         CommentReport[]    @relation("Reporter")
  resolvedCommentReports CommentReport[]    @relation("Moderator")

  @@map("users")
  @@schema("mysic")
}

enum PlaylistVisibility {
  PRIVATE @map("private")
  PUBLIC  @map("public")

  @@map("playlist_visibility")
  @@schema("mysic")
}

model Track {
  id                String             @id @default(uuid()) @db.Uuid
  source            String             @db.VarChar(50)
  sourceId          String             @map("source_id") @db.VarChar(255)
  title             String             @db.VarChar(500)
  artistName        String             @map("artist_name") @db.VarChar(255)
  durationSeconds   Int?               @map("duration_seconds")
  thumbnailUrl      String?            @map("thumbnail_url") @db.Text
  metadataUpdatedAt DateTime           @default(now()) @map("metadata_updated_at") @db.Timestamptz(6)
  history           ListeningHistory[]
  playlistTracks    PlaylistTrack[]
  favorites         Favorite[]
  ratings           Rating[]
  comments          Comment[]

  @@unique([source, sourceId])
  @@map("tracks")
  @@schema("mysic")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([userId, trackId])
  @@index([userId, createdAt])
  @@index([trackId])
  @@map("favorites")
  @@schema("mysic")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  trackId   String   @map("track_id") @db.Uuid
  score     Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("ratings")
  @@schema("mysic")
}

model Playlist {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  name        String             @db.VarChar(150)
  description String?            @db.Text
  visibility  PlaylistVisibility @default(PRIVATE)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]

  @@index([userId, updatedAt])
  @@map("playlists")
  @@schema("mysic")
}

model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@unique([playlistId, position])
  @@index([trackId])
  @@map("playlist_tracks")
  @@schema("mysic")
}

enum CommentStatus {
  visible
  hidden
  deleted

  @@map("comment_status")
  @@schema("mysic")
}

enum CommentReportReason {
  spam
  harassment
  other

  @@map("comment_report_reason")
  @@schema("mysic")
}

enum CommentReportStatus {
  pending
  dismissed
  hidden
  deleted

  @@map("comment_report_status")
  @@schema("mysic")
}

model Comment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  trackId   String          @map("track_id") @db.Uuid
  body      String
  status    CommentStatus   @default(visible)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  reports   CommentReport[]

  @@index([trackId, status, createdAt, id])
  @@index([userId])
  @@map("comments")
  @@schema("mysic")
}

model CommentReport {
  commentId   String              @map("comment_id") @db.Uuid
  reporterId  String              @map("reporter_id") @db.Uuid
  reason      CommentReportReason
  status      CommentReportStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  moderatorId String?             @map("moderator_id") @db.Uuid
  resolvedAt  DateTime?           @map("resolved_at") @db.Timestamptz(3)
  comment     Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter    User                @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User?               @relation("Moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@id([commentId, reporterId])
  @@index([status, commentId, createdAt])
  @@index([reporterId])
  @@index([moderatorId])
  @@map("comment_reports")
  @@schema("mysic")
}

model ListeningHistory {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  trackId           String   @map("track_id") @db.Uuid
  playbackSessionId String   @unique @map("playback_session_id") @db.Uuid
  startedAt         DateTime @map("started_at") @db.Timestamptz(3)
  listenedMs        BigInt   @map("listened_ms")
  completed         Boolean  @default(false)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt, id])
  @@index([userId, trackId])
  @@map("listening_history")
  @@schema("mysic")
}
